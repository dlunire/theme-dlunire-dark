{
    "$schema": "vscode://schemas/color-theme",
    "name": "DLUnire Dark Cyber",
    "colors": {
        "editor.background": "#010305",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#c8f9ff",
        "editorLineNumber.activeForeground": "#00bbff",
        "editor.selectionBackground": "#0091ff33",
        "editor.lineHighlightBackground": "#0A1017",
        // Widget general y ventana flotante (Hover)
        "editorWidget.background": "#030609",
        "editorWidget.border": "#00bbff20",
        "editorWidget.foreground": "#c8f9ff",
        "editorWidget.resizeBorder": "#f0f0f01a",
        // Especifico para el recuadro flotante de documentación
        "editorHoverWidget.background": "#030609",
        "editorHoverWidget.border": "#00bbff20",
        "editorHoverWidget.foreground": "#c8f9ff",
        "editorHoverWidget.statusBarBackground": "#05080C",
        "editorGroup.border": "#00bbff2d",
        "editorGroupHeader.border": "#00bbff2d",
        "editorGroupHeader.tabsBackground": "#030a0c2d",
        "editorGroupHeader.tabsBorder": "#f0f0f013",
        "editorCursor.foreground": "#00E8FF",
        // Diagnósticos (antes ausentes, usaban default de VS Code)
        "editorError.foreground": "#FF2A5F",
        "editorWarning.foreground": "#FFC600",
        "editorInfo.foreground": "#00bbff",
        "editorHint.foreground": "#00FFAA",
        "problemsErrorIcon.foreground": "#FF2A5F",
        "problemsWarningIcon.foreground": "#FFC600",
        "problemsInfoIcon.foreground": "#00bbff",
        "activityBar.background": "#05080C",
        "activityBar.foreground": "#00E8FF",
        "activityBar.inactiveForeground": "#a0e1ff79",
        "activityBar.border": "#00bbff3d",
        "sideBar.background": "#030508",
        "sideBar.foreground": "#c8f9ff",
        "sideBar.border": "#00bbff2d",
        "sideBarTitle.foreground": "#FFFFFF",
        "sideBarSectionHeader.background": "#05080C",
        "sideBarSectionHeader.border": "#00bbff2d",
        "statusBar.background": "#010305",
        "statusBar.foreground": "#c8f9ff",
        "statusBar.border": "#00bbff2d",
        "statusBar.noFolderBackground": "#010305",
        "titleBar.activeBackground": "#010305",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#05080C",
        "titleBar.inactiveForeground": "#c8f9ff",
        "titleBar.border": "#00bbff55",
        // Pestaña Activa (Con foco)
        "tab.activeBackground": "#0A1017",
        "tab.activeForeground": "#00bbff",
        "tab.activeBorderTop": "#00E8FF",
        "tab.activeBorder": "#00E8FF",
        // Pestaña Seleccionada pero NO Enfocada
        "tab.unfocusedActiveBackground": "#0A1017",
        "tab.unfocusedActiveForeground": "#A1A1A1",
        "tab.unfocusedActiveBorderTop": "#00f2ff40",
        "tab.unfocusedActiveBorder": "#00f2ff40",
        // Pestañas Inactivas
        "tab.inactiveBackground": "#05080C",
        "tab.inactiveForeground": "#71d2ffe6",
        "tab.unfocusedInactiveForeground": "#a0e1ffb2",
        // Bordes separadores y hovers
        "tab.hoverBorder": "#00f2ff40",
        "tab.unfocusedHoverBorder": "#a0e1ff4d",
        "tab.border": "#00f2ff40",
        // Listas y Árbol de directorios (Sidebar)
        "list.activeSelectionBackground": "#0D1B2A",
        "list.activeSelectionForeground": "#00E8FF",
        "list.hoverBackground": "#0A1017",
        "list.inactiveSelectionBackground": "#0A1017",
        "list.inactiveSelectionForeground": "#A1A1A1",
        "list.inactiveFocusOutline": "#FFFFFF4D",
        // Minimapa
        "minimapSlider.background": "#00c3ff10",
        "minimapSlider.hoverBackground": "#00ff3c10",
        "minimapSlider.activeBackground": "#00eaff18",
        "minimap.background": "#131a2228",
        // Menús Contextuales
        "menu.background": "#05080C",
        "menu.foreground": "#A1A1A1",
        "menu.selectionBackground": "#0A1017",
        "menu.selectionForeground": "#FFFFFF",
        "menu.separatorBackground": "#FFFFFF1A",
        "menu.border": "#2A3846",
        // Decoración de Git
        "gitDecoration.addedResourceForeground": "#00FFAA",
        "gitDecoration.renamedResourceForeground": "#FFC600",
        "gitDecoration.modifiedResourceForeground": "#FFFFFF",
        "gitDecoration.untrackedResourceForeground": "#00E8FF",
        "gitDecoration.deletedResourceForeground": "#FF2A5F",
        "gitDecoration.ignoredResourceForeground": "#656565",
        "gitDecoration.conflictingResourceForeground": "#FF6D00",
        // Entradas de texto (Inputs y Paleta de comandos)
        "input.background": "#080D14",
        "input.foreground": "#FFFFFF",
        "input.border": "#00bbff40",
        "inputOption.activeBorder": "#00E8FF",
        "inputOption.activeBackground": "#00E8FF22",
        "inputOption.activeForeground": "#00E8FF",
        "inputValidation.errorBackground": "#1A030A",
        "inputValidation.errorBorder": "#F50057",
        "inputValidation.errorForeground": "#FF5588",
        // Contenedor general de inspección (Peek View)
        "peekView.border": "#00bbff2d",
        "peekViewTitle.background": "#05080C",
        "peekViewTitleLabel.foreground": "#FFFFFF",
        "peekViewTitleDescription.foreground": "#71d2ffe6",
        "peekViewEditor.background": "#010305",
        "peekViewEditor.matchHighlightBackground": "#0091ff33",
        "peekViewResult.background": "#030508",
        "peekViewResult.fileForeground": "#FFFFFF",
        "peekViewResult.lineForeground": "#c8f9ff",
        "peekViewResult.matchHighlightBackground": "#0091ff33",
        "peekViewResult.selectionBackground": "#0A1017",
        "peekViewResult.selectionForeground": "#00E8FF",
        // Terminal integrada (Matriz ANSI de 16 colores Cyber)
        "terminal.background": "#010305",
        "terminal.foreground": "#FFFFFF",
        "terminalCursor.foreground": "#00E8FF",
        "terminal.selectionBackground": "#0091ff40",
        "terminal.ansiBlack": "#101A24",
        "terminal.ansiBrightBlack": "#50687F",
        "terminal.ansiRed": "#FF2A5F",
        "terminal.ansiBrightRed": "#FF5588",
        "terminal.ansiGreen": "#00FFAA",
        "terminal.ansiBrightGreen": "#00FFD5",
        "terminal.ansiYellow": "#FFC600",
        "terminal.ansiBrightYellow": "#FFE066",
        "terminal.ansiBlue": "#00E8FF",
        "terminal.ansiBrightBlue": "#33EEFF",
        "terminal.ansiMagenta": "#F50057",
        "terminal.ansiBrightMagenta": "#FF2A85",
        "terminal.ansiCyan": "#00FFCC",
        "terminal.ansiBrightCyan": "#70F3FF",
        "terminal.ansiWhite": "#E0F8FF",
        "terminal.ansiBrightWhite": "#FFFFFF",
        // Búsqueda y resaltado de palabras
        "editor.findMatchBackground": "#00bbff40",
        "editor.findMatchHighlightBackground": "#00E8FF25",
        "editor.wordHighlightBackground": "#0091ff20",
        "editor.selectionHighlightBackground": "#0091ff20",
        // Breadcrumbs
        "breadcrumb.foreground": "#71d2ffe6",
        "breadcrumb.focusForeground": "#00E8FF",
        "breadcrumb.activeSelectionForeground": "#FFFFFF",
        "breadcrumbPicker.background": "#05080C",
        // Activity Bar Badge
        "activityBarBadge.background": "#00E8FF",
        "activityBarBadge.foreground": "#05080C",
        // Bracket pair colorization (antes ausente, usaba colores default)
        "editorBracketHighlight.foreground1": "#00E8FF",
        "editorBracketHighlight.foreground2": "#FF7AC6",
        "editorBracketHighlight.foreground3": "#FFC600",
        "editorBracketHighlight.foreground4": "#00FFAA",
        "editorBracketHighlight.foreground5": "#FF6D00",
        "editorBracketHighlight.foreground6": "#A0A0FF",
        "editorBracketHighlight.unexpectedBracket.foreground": "#FF2A5F",
        "editorIndentGuide.background1": "#00bbff14",
        "editorIndentGuide.activeBackground1": "#00bbff40"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "comment.block.documentation"
            ],
            "settings": {
                "foreground": "#656565",
                "fontStyle": ""
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.word",
                "storage.modifier",
                "storage.type",
                "storage"
            ],
            "settings": {
                "foreground": "#FF6D00"
            }
        },
        {
            "name": "Primitive types",
            "scope": [
                "support.type",
                "support.type.primitive",
                "keyword.type",
                "storage.type.primitive"
            ],
            "settings": {
                "foreground": "#1DE9B6"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#ffffffc0"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#FAA859"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#A0A0FF"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other",
                "variable.language",
                "variable.object"
            ],
            "settings": {
                "foreground": "#00E8FF"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "meta.property-name",
                "entity.name.variable"
            ],
            "settings": {
                "foreground": "#FF9100"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function",
                "entity.name.method"
            ],
            "settings": {
                "foreground": "#FF7AC6"
            }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.class",
                "support.type.class",
                "entity.name.trait"
            ],
            "settings": {
                "foreground": "#00ffaa"
            }
        },
        {
            "name": "Interfaces",
            "scope": [
                "entity.name.interface"
            ],
            "settings": {
                "foreground": "#B983FF"
            }
        },
        {
            "name": "Structs",
            "scope": [
                "entity.name.struct"
            ],
            "settings": {
                "foreground": "#FFD580"
            }
        },
        {
            "name": "Enums",
            "scope": [
                "entity.name.enum"
            ],
            "settings": {
                "foreground": "#33EEFF"
            }
        },
        {
            "name": "Attributes / Decorators",
            "scope": [
                "entity.other.attribute-name",
                "meta.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#F50057"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#1DE9B6"
            }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": {
                "foreground": "#F50057"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#00D0FF"
            }
        },
        {
            "name": "Markdown Bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FFC600",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#00E8FF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#00D0FF",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown Lists",
            "scope": [
                "markup.list"
            ],
            "settings": {
                "foreground": "#FF6D00"
            }
        },
        {
            "name": "Markdown Quotes",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#656565"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FF2A5F",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Operators & Punctuation",
            "scope": [
                "keyword.operator",
                "storage.type.function.arrow"
            ],
            "settings": {
                "foreground": "#5C7A88"
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#00FFAA",
        "interface": "#B983FF",
        "struct": "#FFD580",
        "enum": "#33EEFF",
        "enumMember": "#A0A0FF",
        "function": "#FF7AC6",
        "method": "#FF9CD6",
        "variable": "#00E8FF",
        "parameter": "#70F3FF",
        "property": "#FF9100",
        "namespace": "#00E5D8",
        "keyword": "#FF6D00",
        "number": "#FAA859",
        "string": "#FFFFFF",
        "type": "#1DE9B6",
        "comment": "#656565",
        "decorator": "#F50057"
    }
}