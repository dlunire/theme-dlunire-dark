{
    "$schema": "vscode://schemas/color-theme",
    "name": "DLUnire Dark Soft",
    "colors": {
        "editor.background": "#07090b",
        "editor.foreground": "#FFFFFF",
        "editorLineNumber.foreground": "#c8f9ff",
        "editorLineNumber.activeForeground": "#00bbff",
        "editor.selectionBackground": "#0091ff33",
        "editor.lineHighlightBackground": "#0A1017",
        // Widget del editor de código:
        "editorWidget.background": "#081219",
        "editorWidget.border": "#071c23",
        "editorWidget.foreground": "#ffffff",
        "editorWidget.resizeBorder": "#f0f0f026",
        "editorGroup.border": "#00bbff2d",
        "editorGroupHeader.border": "#00bbff2d",
        "editorGroupHeader.tabsBackground": "#070a0d",
        "editorGroupHeader.tabsBorder": "#f0f0f013",
        "editorCursor.foreground": "#00b3ff",
        "activityBar.background": "#05080C",
        "activityBar.foreground": "#00E8FF",
        "activityBar.inactiveForeground": "#a0e1ff79",
        "sideBar.background": "#070a0d",
        "sideBar.foreground": "#ffffff",
        "sideBar.border": "#00bbff2d",
        "sideBarTitle.foreground": "#FFFFFF",
        "sideBarSectionHeader.background": "#05080C",
        "sideBarSectionHeader.border": "#00bbff2d",
        "statusBar.background": "#010305",
        "statusBar.foreground": "#c8f9ff",
        "statusBar.border": "#00bbff2d",
        "statusBar.noFolderBackground": "#010305",
        "titleBar.activeBackground": "#010305",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveBackground": "#05080C",
        "titleBar.inactiveForeground": "#c8f9ff",
        // Pestaña Activa (Con foco)
        "tab.activeBackground": "#0A1017",
        "tab.activeForeground": "#00bbff",
        "tab.activeBorderTop": "#00E8FF",
        "tab.activeBorder": "#00E8FF",
        // Pestaña Seleccionada pero NO Enfocada (Blanco 30% en bordes)
        "tab.unfocusedActiveBackground": "#0A1017",
        "tab.unfocusedActiveForeground": "#A1A1A1",
        "tab.unfocusedActiveBorderTop": "#00f2ff40",
        "tab.unfocusedActiveBorder": "#00f2ff40",
        // Pestañas Inactivas
        "tab.inactiveBackground": "#05080C",
        "tab.inactiveForeground": "#71d2ffe6",
        "tab.unfocusedInactiveForeground": "#a0e1ffb2",
        // Bordes separadores y hovers
        "tab.hoverBorder": "#00f2ff40",
        "tab.unfocusedHoverBorder": "#a0e1ff4d",
        "tab.border": "#00f2ff40",
        // Listas y Árbol de directorios (Sidebar)
        "list.activeSelectionBackground": "#0D1B2A",
        "list.activeSelectionForeground": "#00E8FF",
        "list.hoverBackground": "#0A1017",
        // Archivo seleccionado pero NO enfocado (Sidebar perdiendo el foco)
        "list.inactiveSelectionBackground": "#0A1017",
        "list.inactiveSelectionForeground": "#A1A1A1",
        // Recuadro blanco al 30% (Sustituto de VS Code para bordes top/bottom)
        "list.inactiveFocusOutline": "#FFFFFF4D",
        // Minimapa
        "minimapSlider.background": "#ffffff10",
        "minimapSlider.hoverBackground": "#ffffff10",
        "minimapSlider.activeBackground": "#00eaff18",
        "minimap.background": "#131a2228",
        // Menús Contextuales (Diseño sutil)
        "menu.background": "#05080C",
        "menu.foreground": "#A1A1A1",
        "menu.selectionBackground": "#0A1017",
        "menu.selectionForeground": "#FFFFFF",
        "menu.separatorBackground": "#FFFFFF1A",
        "menu.border": "#2A3846",
        // Decoración de Git
        "gitDecoration.modifiedResourceForeground": "#FFFFFF",
        "gitDecoration.untrackedResourceForeground": "#00E8FF",
        "gitDecoration.deletedResourceForeground": "#F50057",
        "gitDecoration.ignoredResourceForeground": "#656565",
        // Entradas de texto (Inputs y Paleta de comandos)
        "input.background": "#080D14",
        "input.foreground": "#FFFFFF",
        "input.border": "#2A3846"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": [
                "comment",
                "comment.block",
                "comment.line",
                "comment.block.documentation"
            ],
            "settings": {
                "foreground": "#656565",
                "fontStyle": ""
            }
        },
        {
            "name": "Keywords",
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.word",
                "storage.modifier",
                "storage.type",
                "storage"
            ],
            "settings": {
                "foreground": "#FF6D00"
            }
        },
        {
            "name": "Primitive types",
            "scope": [
                "support.type",
                "support.type.primitive",
                "keyword.type",
                "storage.type.primitive"
            ],
            "settings": {
                "foreground": "#FFC600"
            }
        },
        {
            "name": "Strings",
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.regexp"
            ],
            "settings": {
                "foreground": "#FFFFFF"
            }
        },
        {
            "name": "Numbers",
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#FAA859"
            }
        },
        {
            "name": "Constants",
            "scope": [
                "constant",
                "constant.language",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#A0A0FF"
            }
        },
        {
            "name": "Variables",
            "scope": [
                "variable",
                "variable.parameter",
                "variable.other",
                "variable.language",
                "variable.object"
            ],
            "settings": {
                "foreground": "#00E8FF"
            }
        },
        {
            "name": "Properties",
            "scope": [
                "variable.other.property",
                "support.type.property-name",
                "meta.property-name",
                "entity.name.variable"
            ],
            "settings": {
                "foreground": "#FF9100"
            }
        },
        {
            "name": "Functions",
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call",
                "variable.function",
                "entity.name.method"
            ],
            "settings": {
                "foreground": "#A0E5FF"
            }
        },
        {
            "name": "Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.class",
                "support.type.class",
                "entity.name.struct",
                "entity.name.interface",
                "entity.name.enum",
                "entity.name.trait"
            ],
            "settings": {
                "foreground": "#00FF00"
            }
        },
        {
            "name": "Attributes / Decorators",
            "scope": [
                "entity.other.attribute-name",
                "meta.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#F50057"
            }
        },
        {
            "name": "HTML/XML Tags",
            "scope": [
                "entity.name.tag"
            ],
            "settings": {
                "foreground": "#1DE9B6"
            }
        },
        {
            "name": "HTML/XML Attributes",
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.xml"
            ],
            "settings": {
                "foreground": "#F50057"
            }
        },
        {
            "name": "Markdown Headings",
            "scope": [
                "markup.heading",
                "markup.heading.markdown"
            ],
            "settings": {
                "foreground": "#00D0FF"
            }
        },
        {
            "name": "Markdown Bold",
            "scope": [
                "markup.bold"
            ],
            "settings": {
                "foreground": "#FFC600",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markdown Italic",
            "scope": [
                "markup.italic"
            ],
            "settings": {
                "foreground": "#00E8FF",
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markdown Links",
            "scope": [
                "markup.underline.link",
                "string.other.link"
            ],
            "settings": {
                "foreground": "#00D0FF",
                "fontStyle": "underline"
            }
        },
        {
            "name": "Markdown Lists",
            "scope": [
                "markup.list"
            ],
            "settings": {
                "foreground": "#FF6D00"
            }
        },
        {
            "name": "Markdown Quotes",
            "scope": [
                "markup.quote"
            ],
            "settings": {
                "foreground": "#656565"
            }
        },
        {
            "name": "Invalid",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#FFFFFF",
            }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "class": "#00FF00",
        "interface": "#00FF00",
        "struct": "#00FF00",
        "enum": "#00FF00",
        "enumMember": "#A0A0FF",
        "function": "#A0E5FF",
        "method": "#A0E5FF",
        "variable": "#00E8FF",
        "parameter": "#00E8FF",
        "property": "#FF9100",
        "namespace": "#00FF00",
        "keyword": "#FF6D00",
        "number": "#FAA859",
        "string": "#FFFFFF",
        "type": "#FFC600",
        "comment": "#656565",
        "decorator": "#F50057"
    }
}